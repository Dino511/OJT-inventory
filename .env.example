APP_NAME=Laravel
APP_ENV=local
# Leave blank, then run `php artisan key:generate` after copying this file
# to .env — never reuse another install's key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This app is built against SQL Server. DB_HOST/DB_DATABASE/DB_USERNAME/
# DB_PASSWORD below are placeholders — every value is specific to whichever
# machine you're running on, so they can't be copied from another install:
#   - DB_HOST: this machine's SQL Server instance name, e.g.
#     'YOUR-PC-NAME\SQLEXPRESS' for a local SQL Server Express install, or
#     just a hostname/IP for a named server elsewhere on the network.
#   - DB_USERNAME/DB_PASSWORD: leave both blank ONLY if this app runs as a
#     Windows user that already has trusted-connection access to that SQL
#     Server instance (the common local-dev setup). Otherwise create a SQL
#     Server login for this app and put its credentials here.
#   - DB_DATABASE: an empty database this app's migrations will create the
#     schema in — create it first (e.g. via SSMS: right-click Databases >
#     New Database), then run `php artisan migrate`.
DB_CONNECTION=sqlsrv
DB_HOST='YOUR-PC-NAME\SQLEXPRESS'
DB_PORT=""
DB_DATABASE=inventory
DB_USERNAME=""
DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Used for password-reset emails (PasswordResetController). A Gmail account
# needs 2-Step Verification turned on and an App Password generated at
# https://myaccount.google.com/apppasswords — do NOT use your normal Gmail
# password here. Any other SMTP provider's settings work the same way.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
